@implements IDisposable
@inject ApiKeyService ApiKeyService
@inject LocaleService LocaleService

@if (!hasApiKey)
{
    <button
        class="btn btn-authenticate"
        title="@L.Authenticate"
        @onclick="OpenAuthenticationDialog">
        <i class="fa-solid fa-user-lock"></i>
    </button>
}
else
{
    <button class="btn btn-clear-key" title="@L.Deauthenticate" @onclick="ClearApiKeyAsync">
        <i class="fa-solid fa-unlock"></i>
    </button>
}

@if (isAuthenticationDialogVisible)
{
    <div class="auth-popup-backdrop" @onclick="CloseAuthenticationDialog"></div>

    <div
        class="auth-popup"
        role="dialog"
        aria-modal="true"
        aria-labelledby="auth-popup-title"
        @onclick:stopPropagation="true"
        @onkeydown="OnKeyDownAsync">
        <div id="auth-popup-title" class="auth-popup-title">@L.Authenticate</div>

        <label class="auth-popup-label" for="auth-api-key">@L.ApiKeyPlaceholder</label>
        <input
            id="auth-api-key"
            type="password"
            class="auth-popup-input"
            autocomplete="current-password"
            spellcheck="false"
            @bind="apiKeyInputValue"
            @bind:event="oninput" />

        @if (!string.IsNullOrWhiteSpace(validationMessage))
        {
            <p class="auth-popup-error" role="alert">@validationMessage</p>
        }

        <div class="auth-popup-actions">
            <button class="btn btn-auth-cancel" @onclick="CloseAuthenticationDialog">
                @L.Cancel
            </button>
            <button class="btn btn-auth-confirm" @onclick="SaveApiKeyAsync">
                @L.Save
            </button>
        </div>
    </div>
}

@code {
    private bool hasApiKey;
    private bool isAuthenticationDialogVisible;
    private string apiKeyInputValue = "";
    private string validationMessage;

    private LocalisationStrings L => LocaleService.Strings;

    protected override async Task OnInitializedAsync()
    {
        LocaleService.OnChange += OnLocaleChanged;
        string apiKey = await ApiKeyService.GetApiKeyAsync();
        hasApiKey = !string.IsNullOrEmpty(apiKey);
    }

    private void OnLocaleChanged() => InvokeAsync(StateHasChanged);

    public void Dispose() => LocaleService.OnChange -= OnLocaleChanged;

    private void OpenAuthenticationDialog()
    {
        apiKeyInputValue = "";
        validationMessage = null;
        isAuthenticationDialogVisible = true;
    }

    private void CloseAuthenticationDialog()
    {
        isAuthenticationDialogVisible = false;
        validationMessage = null;
    }

    private async Task SaveApiKeyAsync()
    {
        string apiKey = apiKeyInputValue?.Trim();

        if (string.IsNullOrWhiteSpace(apiKey))
        {
            validationMessage = L.ApiKeyRequired;

            return;
        }

        await ApiKeyService.SetApiKeyAsync(apiKey);

        hasApiKey = true;
        CloseAuthenticationDialog();
    }

    private async Task ClearApiKeyAsync()
    {
        await ApiKeyService.ClearApiKeyAsync();

        hasApiKey = false;
    }

    private async Task OnKeyDownAsync(KeyboardEventArgs keyboardEventArgs)
    {
        if (keyboardEventArgs.Key == "Escape")
        {
            CloseAuthenticationDialog();

            return;
        }

        if (keyboardEventArgs.Key == "Enter")
        {
            await SaveApiKeyAsync();
        }
    }
}
